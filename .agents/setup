#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  printf '\n==> %s\n' "$1"
}

step "Checking Bun"
command -v bun >/dev/null
bun --version

step "Configuring virtual memory for Oxlint plugins"
# Oxlint's JavaScript-plugin bridge reserves a 4 GiB virtual arena. Small
# no-swap orbs need permissive overcommit even though the arena is sparsely used.
if [[ "$(< /proc/sys/vm/overcommit_memory)" != "1" ]]; then
  sudo -n sysctl -w vm.overcommit_memory=1
fi

step "Installing locked JavaScript dependencies"
bun install --frozen-lockfile
