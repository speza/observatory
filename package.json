{
  "name": "observatory",
  "version": "0.1.0",
  "private": true,
  "description": "An agent observatory for supervising AI agent work.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/main.ts",
    "dev:mock": "AO_HOST=mock AO_MOCK_SCENARIO=orbit AO_MOCK_SEED=portfolio AO_DB_PATH=${TMPDIR:-/tmp}/ao-mock.sqlite bun --watch run src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:web:api": "AO_WEB_PORT=4311 bun --watch run src/web/main.ts",
    "web": "bun run build:web && bun run src/web/main.ts",
    "web:mock": "bun run build:web && AO_HOST=mock AO_MOCK_SCENARIO=portfolio AO_MOCK_SEED=portfolio AO_DB_PATH=${TMPDIR:-/tmp}/ao-web-mock.sqlite bun run src/web/main.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:interaction-poc": "bun run src/prototypes/agent-interaction-poc.ts",
    "dev:pty-poc": "bun run src/prototypes/pty-terminal-poc.ts",
    "dev:herdr-terminal-poc": "bun run src/prototypes/herdr-terminal-poc.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "test:herdr": "bun test src/hosts/herdr/herdr.test.ts",
    "test:all": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "oxlint --config .oxlintrc.json .",
    "lint:fix": "oxlint --config .oxlintrc.json --fix .",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --config .oxfmtrc.json --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@effect/platform-bun": "0.91.2",
    "@opentui/core": "0.4.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "effect": "3.22.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "latest",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.8.3",
    "vite": "8.2.2"
  }
}
