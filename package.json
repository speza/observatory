{
  "name": "ao-live-herdr-command-centre",
  "version": "0.1.0",
  "private": true,
  "description": "V0 live Herdr spatial universe/map proof of concept.",
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "test:herdr": "bun test src/hosts/herdr/herdr.test.ts",
    "test:all": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src fixtures",
    "format:check": "oxfmt --check src fixtures",
    "check": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@opentui/core": "0.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.7.0",
    "oxlint": "0.15.0",
    "typescript": "5.8.3"
  }
}
