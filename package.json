{
  "name": "observatory",
  "version": "0.1.0",
  "private": true,
  "description": "An agent observatory for supervising AI agent work.",
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "dev:mock": "AO_HOST=mock AO_MOCK_SCENARIO=orbit AO_MOCK_SEED=portfolio AO_DB_PATH=${TMPDIR:-/tmp}/ao-mock.sqlite bun run src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "test:herdr": "bun test src/hosts/herdr/herdr.test.ts",
    "test:all": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json .",
    "lint:fix": "oxlint --config .oxlintrc.json --fix .",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --config .oxfmtrc.json --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@opentui/core": "0.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.8.3"
  }
}
